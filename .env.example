# AuraBrief 95 — Environment Configuration
# Copy this file to .env and edit the values below.
#
# Usage:
#   cp .env.example .env
#   docker-compose up --build

# ---------------------------------------------------------------------------
# Ollama LLM Configuration (Gen-AI Explanations)
# ---------------------------------------------------------------------------

# URL of the Ollama server. Set to your teammate's laptop IP if Ollama
# runs on another machine on the local network.
#
# Examples:
#   Same machine (outside Docker): http://host.docker.internal:11434
#   Teammate's laptop:             http://192.168.1.42:11434
OLLAMA_HOST=http://host.docker.internal:11434

# Which Ollama model to use for generating explanations.
# Common options: llama3, mistral, gemma2, phi3
OLLAMA_MODEL=llama3

# ---------------------------------------------------------------------------
# Simulator Configuration
# ---------------------------------------------------------------------------

# Seconds between event batches. Lower = more events, higher load.
# Recommended: 5 for demo, 2 for stress testing, 10 for slow walkthrough.
STREAM_INTERVAL=5

# ---------------------------------------------------------------------------
# Database Configuration
# ---------------------------------------------------------------------------

# SQLite database path (relative to backend working directory).
# The ./data/ directory is mounted as a Docker volume for persistence.
DATABASE_URL=sqlite:///./data/aurabrief.db

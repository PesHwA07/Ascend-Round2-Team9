# ===================================================================
# AuraBrief 95 — Environment Configuration
# Copy to `.env` and adjust. Never commit real secrets.
#
# Usage:
#   cp .env.example .env
#   docker-compose up --build
# ===================================================================

# ---------------------------------------------------------------------------
# Gen-AI / Ollama Explanation Layer
# ---------------------------------------------------------------------------

# Master switch for LLM explanations (false = template fallback only)
OLLAMA_ENABLED=true

# URL of the Ollama server.
# Inside Docker: use host.docker.internal to reach host machine
# Teammate's laptop: use their IP (e.g., http://192.168.1.42:11434)
OLLAMA_HOST=http://host.docker.internal:11434

# Small instruction model that fits the 5s triage SLA on laptop hardware.
# `ollama pull llama3.2:3b`
OLLAMA_MODEL=llama3.2:3b

# Hard per-request timeout in seconds; keeps triage inside the 5s SLA
OLLAMA_TIMEOUT=6.0

# Max tokens the model may generate for one explanation
OLLAMA_NUM_PREDICT=150

# After an Ollama failure, skip the LLM for this many seconds (circuit breaker)
LLM_COOLDOWN_SECONDS=60

# ---------------------------------------------------------------------------
# Simulator Configuration
# ---------------------------------------------------------------------------

# Seconds between event batches. Lower = more events, higher load.
# Recommended: 5 for demo, 2 for stress testing, 10 for slow walkthrough.
STREAM_INTERVAL=5

# ---------------------------------------------------------------------------
# Database Configuration
# ---------------------------------------------------------------------------

# SQLite database path (relative to backend working directory).
# The ./data/ directory is mounted as a Docker volume for persistence.
DATABASE_URL=sqlite:///./data/aurabrief.db
